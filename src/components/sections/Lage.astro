---
import Icon from '../Icon.astro';

const schmerzen = [
  { schmerz: 'Angebote dauern zu lange', system: 'Automatisierte Angebotserstellung' },
  { schmerz: 'Terminvereinbarung ist aufwendig', system: 'Automatisierte Terminbuchung' },
  { schmerz: 'Recherche frisst Stunden', system: 'KI-gestützte Recherche' },
  { schmerz: 'Berichte kosten jede Woche Zeit', system: 'Automatisierte Berichte' },
  { schmerz: 'Buchhaltung ist aufwendig', system: 'Digitaler Rechnungsworkflow' },
  { schmerz: 'Akquise und Nachfassen bleiben liegen', system: 'Automatisierte Kundenansprache mit Follow-up' },
];
---
<section class="section lage" aria-labelledby="lage-title">
  <div class="wrap">
    <div class="stats">
      <h2 id="lage-title" class="statement" data-reveal>
        <span class="big">88 %</span> der Unternehmen nutzen KI.<br />
        <span class="big">5 %</span> schaffen damit echten Wert.<sup><a href="#quellen" aria-label="Quellen">1</a></sup>
      </h2>
      <p class="lead" data-reveal style="--i: 1">
        Der Unterschied: Sie wissen, <em class="accent">wofür.</em> Wert entsteht durch durchgängig neu gestaltete Abläufe,
        nicht durch isolierte Pilotprojekte. Deshalb baue ich Systeme statt Einzellösungen.
      </p>
      <p class="source" id="quellen">
        1 McKinsey, The State of AI 2025 (88 % nutzen KI in mindestens einem Bereich). BCG, The Widening AI Value Gap,
        September 2025 (5 % erzielen substanziellen Wert im großen Maßstab). Beide Studien weltweit.
      </p>
    </div>

    <div class="pains">
      <h3 data-reveal>Wo Mittelständler heute am meisten Zeit verlieren, und was dagegen hilft</h3>
      <ul>
        {
          schmerzen.map((s, i) => (
            <li data-reveal style={`--i: ${i % 2}`}>
              <span class="pain">{s.schmerz}</span>
              <span class="fix">
                <Icon name="arrow-right" />
                {s.system}
              </span>
            </li>
          ))
        }
      </ul>
      <p class="note muted">Die häufigsten Antworten aus einer Teilnehmerumfrage unter Unternehmern, September 2026.</p>
    </div>
  </div>
</section>

<style>
  .stats {
    display: grid;
    gap: 2rem;
    max-width: 60rem;
  }

  .statement {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem);
    line-height: 1.15;
  }

  .big {
    font-variant-numeric: lining-nums;
    color: var(--navy);
    font-weight: 600;
  }

  sup {
    font-family: var(--sans);
    font-size: 0.35em;
    vertical-align: super;
    margin-left: 0.15em;
  }

  sup a {
    color: var(--gold-deep);
    text-decoration: none;
  }

  .source {
    font-size: 0.9375rem;
    color: var(--stone);
    max-width: 48rem;
  }

  .pains {
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .pains h3 {
    max-width: 26em;
    margin-bottom: 2rem;
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 5vw, 5rem);
  }

  li {
    display: grid;
    gap: 0.35rem;
    padding-block: 1.25rem;
    border-top: 1px solid var(--line);
  }

  li:nth-child(-n + 2) {
    border-top: 0;
    padding-top: 0.25rem;
  }

  .pain {
    font-family: var(--serif);
    font-size: var(--step-1);
    color: var(--ink);
  }

  .fix {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold-deep);
    font-weight: 600;
    font-size: 1.0625rem;
  }

  .fix :global(svg) {
    width: 1rem;
    height: 1rem;
    flex: none;
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 760px) {
    ul {
      grid-template-columns: 1fr;
    }
    li:nth-child(2) {
      border-top: 1px solid var(--line);
      padding-top: 1.25rem;
    }
  }
</style>
