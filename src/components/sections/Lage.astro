---
const schmerzen = [
  {
    problem: 'Angebotserstellung dauert zu lange',
    loesung: 'Automatisierte Angebotserstellung mit Mustervorlagen',
    detail: 'Daten aus Anfrage und Kalkulation fließen direkt ins Angebot. Sie prüfen nur noch und versenden.',
  },
  {
    problem: 'Terminvereinbarung ist aufwendig',
    loesung: 'Terminbuchungstools auf der Homepage oder Terminagenten',
    detail: 'Kunden buchen freie Zeiten selbst, Bestätigung und Erinnerung laufen automatisch.',
  },
  {
    problem: 'Zu wenig Personal für Kundenservice',
    loesung: 'Schnellbausteine oder Serviceagenten verkürzen die Bearbeitungszeit',
    detail: 'Standardanfragen werden vorbereitet oder direkt beantwortet. Ihr Team kümmert sich um die Sonderfälle.',
  },
  {
    problem: 'Recherche und Berichterstellung sind zeitaufwendig',
    loesung: 'KI-unterstützte Recherche und automatische Berichterstellung',
    detail: 'Informationen werden gebündelt und strukturiert aufbereitet, Berichte entstehen aus Ihren vorhandenen Daten.',
  },
  {
    problem: 'Buchhaltung bindet viele Kapazitäten',
    loesung: 'Digitalisierung des gesamten Workflows',
    detail: 'Vom Belegeingang über Prüfung und Freigabe bis zur Buchung, oft mit Bordmitteln, die schon im Haus sind.',
  },
  {
    problem: 'Akquise geht im Tagesgeschäft unter',
    loesung: 'Automatisierte Kundenansprache mit Follow-up-System',
    detail: 'Kontakte werden zum richtigen Zeitpunkt nachgefasst, damit kein Interessent im Alltag vergessen wird.',
  },
];
---
<section class="section lage" aria-labelledby="lage-title">
  <div class="wrap">
    <h2 id="lage-title" class="statement" data-reveal>
      <span class="big">88&nbsp;%</span> der Unternehmen nutzen KI.<br />
      <span class="big">5&nbsp;%</span> schaffen damit echten Wert.<sup><a href="#quellen" aria-label="Quellen">1</a></sup>
    </h2>

    <div class="unterschied">
      <p data-reveal style="--i: 1">
        Der Unterschied liegt in der Herangehensweise. Wer von den Tools her denkt und handelt, nutzt KI zwar wie die
        große Mehrheit der 88&nbsp;%, erzielt damit aber selten echten Wert. Es bleibt bei Einzellösungen und
        Pilotprojekten, die im Alltag verpuffen.
      </p>
      <p data-reveal style="--i: 2">
        Die 5&nbsp;% handeln lösungsorientiert. Sie identifizieren zuerst ihre Problemfelder, gehen die Lösungen
        strategisch an und setzen dann passende Tools ein: als Werkzeug, nicht als Ausgangspunkt. So entsteht Wert durch
        konsequent neu gestaltete Abläufe und Systeme, die <em class="accent">ineinandergreifen.</em>
      </p>
    </div>

    <p class="source" id="quellen">
      1 <a href="https://www.mckinsey.com/capabilities/quantumblack/our-insights/the-state-of-ai" rel="noopener" target="_blank">McKinsey, The State of AI 2025</a>:
      88&nbsp;% nutzen KI in mindestens einem Bereich.{' '}
      <a href="https://www.bcg.com/press/30september2025-ai-leaders-outpace-laggards-revenue-growth-cost-savings" rel="noopener" target="_blank">BCG, The Widening AI Value Gap, September 2025</a>:
      5&nbsp;% erzielen substanziellen Wert im großen Maßstab. Beide Studien weltweit.
    </p>

    <div class="pains">
      <h3 data-reveal>Wo Mittelständler heute am meisten Zeit verlieren, und was dagegen hilft</h3>
      <p class="hint muted">Fahren Sie über eine Karte, um die Lösung zu sehen.</p>
      <ul class="karten">
        {
          schmerzen.map((s, i) => (
            <li class="karte" tabindex="0" data-reveal style={`--i: ${i % 3}`}>
              <p class="problem">{s.problem}</p>
              <div class="loesung">
                <div class="inhalt">
                  <p class="titel">{s.loesung}</p>
                  <p class="detail">{s.detail}</p>
                </div>
              </div>
            </li>
          ))
        }
      </ul>
      <p class="note muted">Die häufigsten Engpässe aus Gesprächen und einer Teilnehmerumfrage unter Unternehmern, 2026.</p>
    </div>
  </div>
</section>

<style>
  .statement {
    font-size: clamp(2rem, 1.3rem + 2.6vw, 3.5rem);
    line-height: 1.15;
  }

  .big {
    font-variant-numeric: lining-nums;
    color: var(--navy);
    font-weight: 600;
  }

  sup {
    font-family: var(--sans);
    font-size: 0.35em;
    vertical-align: super;
    margin-left: 0.15em;
  }

  sup a {
    color: var(--gold-deep);
    text-decoration: none;
  }

  .unterschied {
    display: grid;
    gap: 1.25rem;
    margin-top: 2.5rem;
    max-width: 68rem;
  }

  .unterschied p {
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.625rem);
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }

  .unterschied p:first-child {
    color: var(--stone);
  }

  .source {
    margin-top: 2rem;
    font-size: 0.9375rem;
    color: var(--stone);
    max-width: 68rem;
  }

  .source a {
    color: var(--stone);
  }

  .pains {
    margin-top: clamp(4rem, 7vw, 6rem);
    padding-top: 3rem;
    border-top: 1px solid var(--line);
  }

  .pains h3 {
    max-width: 28em;
  }

  .hint {
    margin-top: 0.75rem;
    font-size: 1rem;
  }

  .karten {
    list-style: none;
    margin: 2rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.25rem;
  }

  /* Subgrid: Trennlinie sitzt in jeder Kartenreihe auf gleicher Höhe. */
  .karte {
    display: grid;
    grid-row: span 2;
    grid-template-rows: subgrid;
    row-gap: 1.25rem;
    padding: 1.75rem 1.75rem 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    outline: none;
    transition:
      background-color 250ms ease,
      border-color 250ms ease;
  }


  .problem {
    font-family: var(--serif);
    font-size: clamp(1.375rem, 1.2rem + 0.5vw, 1.625rem);
    line-height: 1.3;
    color: var(--navy);
    transition: color 250ms ease;
  }

  .problem {
    align-self: start;
  }

  .loesung {
    display: grid;
    align-content: start;
    gap: 0.4rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    transition: border-color 250ms ease;
  }

  .inhalt {
    display: grid;
    gap: 0.4rem;
  }

  .titel {
    font-weight: 600;
    line-height: 1.4;
    color: var(--gold-deep);
    transition: color 250ms ease;
  }

  .detail {
    font-size: 1rem;
    line-height: 1.5;
    color: var(--stone);
    transition: color 250ms ease;
  }

  /* Geräte mit Maus: Lösung erscheint beim Überfahren, Karte färbt sich blau. */
  @media (hover: hover) and (pointer: fine) {
    .karte {
      cursor: default;
    }

    .inhalt {
      opacity: 0;
      transform: translateY(8px);
      transition:
        opacity 250ms var(--ease-out),
        transform 250ms var(--ease-out);
    }

    .karte:hover,
    .karte:focus-visible {
      background: var(--navy);
      border-color: var(--navy);
    }

    .karte:hover .inhalt,
    .karte:focus-visible .inhalt {
      opacity: 1;
      transform: none;
    }

    .karte:hover .loesung,
    .karte:focus-visible .loesung {
      border-color: var(--line-dark);
    }

    .karte:hover .problem,
    .karte:focus-visible .problem {
      color: var(--white);
    }


    .karte:hover .titel,
    .karte:focus-visible .titel,
    .karte:hover .detail,
    .karte:focus-visible .detail {
      color: var(--gold);
    }
  }

  /* Touch-Geräte: Lösung ist immer sichtbar. */
  @media not ((hover: hover) and (pointer: fine)) {
    .hint {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .inhalt {
      transform: none !important;
    }
  }

  .note {
    margin-top: 1.5rem;
    font-size: 0.9375rem;
  }

  @media (max-width: 1024px) {
    .karten {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .karten {
      grid-template-columns: 1fr;
    }
  }
</style>
