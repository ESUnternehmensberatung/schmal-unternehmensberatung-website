---
import { url } from '../../utils/url';
import { empfehlungAnfrage } from '../../config/site';
import { gruppen } from '../../data/concierge';
import Icon from '../Icon.astro';

interface Props {
  seite?: boolean; // eigene Unterseite: Überschrift als h1
}
const { seite = false } = Astro.props;
const Titel = seite ? 'h1' : 'h2';
const zeigeBlog = false; // auf true setzen, sobald der erste Erfahrungsbericht im Blog steht
---
<section class="section concierge" id="concierge" aria-labelledby="concierge-title">
  <div class="wrap">
    <header class="intro">
      <Titel id="concierge-title" class="titel" data-reveal>Business-Concierge</Titel>
      <p class="lead" data-reveal style="--i: 1">
        Als Unternehmensberater werde ich häufig nach Tools oder Lösungen zu verschiedenen Themen gefragt. Hier finden
        Sie meine Empfehlungen: Tools, die ich selbst verwende, und Partner, mit denen ich zusammenarbeite.
      </p>
      <p class="hinweis" data-reveal style="--i: 2">
        <strong>Transparenz:</strong> Für einige Empfehlungen erhalte ich eine Provision. Ihr Preis ändert sich dadurch
        nicht.
        {
          zeigeBlog && (
            <>
              Ausführliche Erfahrungsberichte erscheinen im <a href={url('/blog/')}>Blog</a>.
            </>
          )
        }
      </p>
    </header>

    <div class="register">
      {
        gruppen.map((g) => (
          <section class="gruppe" aria-label={g.titel} data-reveal>
            <h3 class="gruppe-titel">{g.titel}</h3>
            <ul>
              {g.eintraege.map((e) => (
                <li>
                  <details>
                    <summary>
                      <span class="name">{e.name}</span>
                      <span class="text">{e.text}</span>
                      <span class="art">{e.art}</span>
                      <Icon name="plus" />
                    </summary>
                    <div class="mehr">
                      <p>
                        <span>{e.art === 'Tool' ? 'Wofür ich es einsetze' : 'Wann ich es empfehle'}</span>
                        {e.einsatz}
                      </p>
                      {e.partnerlink ? (
                        <a href={e.partnerlink} rel="noopener sponsored" target="_blank">
                          {e.name} ansehen <Icon name="arrow-up-right" />
                          <span class="visually-hidden">(öffnet in neuem Tab)</span>
                        </a>
                      ) : (
                        <a href={empfehlungAnfrage(e.name)}>
                          Kontakt zu {e.name} anfragen <Icon name="arrow-right" />
                        </a>
                      )}
                    </div>
                  </details>
                </li>
              ))}
            </ul>
          </section>
        ))
      }
    </div>
  </div>
</section>

<style>
  .titel {
    font-size: var(--step-3);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    max-width: 52rem;
  }

  .hinweis {
    font-size: 1rem;
    color: var(--stone);
  }

  .hinweis strong {
    color: var(--navy);
  }

  .register {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    border-top: 2px solid var(--navy);
  }

  /* Gruppe: Titel links, Einträge rechts */
  .gruppe {
    display: grid;
    grid-template-columns: 3fr 9fr;
    gap: 1rem clamp(2rem, 4vw, 4rem);
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--line);
  }

  .gruppe-titel {
    padding-top: 1.1rem;
    font-family: var(--sans);
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--gold-deep);
  }

  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  li + li {
    border-top: 1px solid var(--line);
  }

  summary {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr 6rem 1.25rem;
    align-items: baseline;
    gap: 0.5rem 2rem;
    padding: 1rem 0.75rem;
    margin-inline: -0.75rem;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius);
    transition: background-color 200ms var(--ease-out);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: 2px;
  }

  .name {
    font-family: var(--serif);
    font-size: 1.375rem;
    line-height: 1.25;
    color: var(--navy);
  }

  .text {
    font-size: 1.0625rem;
    color: var(--stone);
  }

  .art {
    justify-self: end;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--stone);
    padding: 0.15rem 0.5rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: var(--white);
  }

  summary :global(svg) {
    align-self: center;
    width: 1.1rem;
    height: 1.1rem;
    color: var(--navy);
    transition: transform 250ms var(--ease-out);
  }

  details[open] summary :global(svg) {
    transform: rotate(45deg);
  }

  .mehr {
    display: grid;
    grid-template-columns: minmax(10rem, 15rem) 1fr;
    gap: 1rem 2rem;
    padding: 0.25rem 0 1.5rem;
  }

  .mehr p {
    grid-column: 2;
    max-width: 40em;
  }

  .mehr p span {
    display: block;
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  .mehr a {
    grid-column: 2;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    color: var(--gold-deep);
  }

  .mehr a :global(svg) {
    width: 1rem;
    height: 1rem;
  }

  @media (hover: hover) and (pointer: fine) {
    summary:hover {
      background: var(--white);
    }
  }

  @media (max-width: 900px) {
    .gruppe {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .gruppe-titel {
      padding-top: 0;
    }
    summary {
      grid-template-columns: 1fr auto 1.25rem;
    }
    .text {
      grid-column: 1 / -1;
      grid-row: 2;
    }
    .mehr {
      grid-template-columns: 1fr;
    }
    .mehr p,
    .mehr a {
      grid-column: 1;
    }
  }
</style>
