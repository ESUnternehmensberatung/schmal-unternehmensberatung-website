---
import Icon from '../Icon.astro';
import Karussell from '../Karussell.astro';
import { bewertungen } from '../../data/bewertungen';
import { site } from '../../config/site';

// Neue Fälle einfach als weiteres Objekt ergänzen; Karussell und Zähler passen sich an.
const faelle = [
  {
    thema: 'Rechnungswesen',
    vorher: 'Manueller Rechnungsprozess mit hohem Buchhaltungsaufwand',
    loesung: 'Rechnungsworkflow komplett digitalisiert, mit vorhandenen Bordmitteln.',
    nachher: '35\u00a0%',
    einheit: 'Zeitersparnis in der Buchhaltung',
  },
  {
    thema: 'Beschwerdebearbeitung',
    vorher: '2 bis 3 Stunden je Beschwerde',
    loesung: 'Prozess umgebaut: Routine automatisiert, Rücksprache und Freigabe bleiben beim Menschen.',
    nachher: '10 bis 15 Min.',
    einheit: 'je Beschwerde, inklusive Rücksprache und Freigabe',
  },
  {
    thema: 'Angebotserstellung',
    vorher: '3 bis 5 Tage, bis das Angebot beim Kunden war',
    loesung: 'Angebotsmanagement neu aufgesetzt und beschleunigt.',
    nachher: '1 bis 24 Std.',
    einheit: 'bis das Angebot beim Kunden ist, je nach Komplexität',
  },
  {
    thema: 'Projektaufnahme',
    vorher: 'Notizen von Hand bei der Besichtigung, später im Büro abgetippt, erst dann das Angebot kalkuliert',
    loesung: 'Digitales Aufnahmeformular: Daten und Fotos sofort im Büro, direkt digital weiterverarbeitet.',
    nachher: '1 Std.',
    einheit: 'Ersparnis je Projektanfrage, bei besserer Datenqualität',
  },
  {
    thema: 'Preisschilder',
    vorher: 'Preisschilder wurden von Hand geschrieben',
    loesung: 'Erstellung der Preisschilder automatisiert.',
    nachher: '5 Tage',
    einheit: 'Arbeit pro Monat gespart',
  },
  {
    thema: 'Palettenetiketten',
    vorher: 'Palettenetiketten wurden manuell ausgefüllt',
    loesung: 'Erstellung der Etiketten automatisiert.',
    nachher: '4 Wochen',
    einheit: 'Arbeitszeit pro Jahr gespart',
  },
  {
    thema: 'Kernprozesse',
    vorher: 'Kernprozesse mit vielen manuellen Schritten',
    loesung: 'Kernprozesse digitalisiert und automatisiert.',
    nachher: '1,5',
    einheit: 'Vollzeitstellen in 2 Monaten eingespart',
  },
];

const methode = ['Prozess verstehen', 'Bereinigen', 'Digital gestalten und automatisieren', 'Testen', 'Produktiv setzen'];
---
<section class="section ergebnisse" id="ergebnisse" aria-labelledby="ergebnisse-title">
  <Karussell id="ergebnisse" anzahl={faelle.length} label="Ergebnisse" breite="25rem">
    <div class="intro" slot="kopf">
      <h2 id="ergebnisse-title" data-reveal>Vorher, nachher. Aus echten Projekten.</h2>
      <p class="lead muted" data-reveal style="--i: 1">
        Die folgenden 5 Schritte haben immer zu belegbaren Ergebnissen geführt:
      </p>

      <ol class="methode" data-reveal style="--i: 2" aria-label="Vorgehen in jedem Projekt">
        {methode.map((m) => <li>{m}</li>)}
      </ol>
    </div>

    {
      faelle.map((f, i) => (
        <li class="fall" aria-label={`${i + 1} von ${faelle.length}: ${f.thema}`}>
          <h3>{f.thema}</h3>
          <div class="vorher">
            <span class="label">Vorher</span>
            <p>{f.vorher}</p>
          </div>
          <p class="loesung">{f.loesung}</p>
          <div class="nachher">
            <span class="label">Nachher</span>
            <p class="wert">{f.nachher}</p>
            <p class="einheit">{f.einheit}</p>
          </div>
        </li>
      ))
    }
  </Karussell>

  <div class="wrap">
    {
      bewertungen.length > 0 && (
        <div class="stimmen">
          <h3>Das sagen Kunden auf Google</h3>
          <ul>
            {bewertungen.map((b) => (
              <li>
                <p class="sterne" aria-label={`${b.sterne} von 5 Sternen`}>
                  {Array.from({ length: b.sterne }, () => <Icon name="star-fill" />)}
                </p>
                <blockquote>
                  <p>{b.text}</p>
                </blockquote>
                <p class="name">{b.name}</p>
              </li>
            ))}
          </ul>
          {site.links.googleProfil && (
            <a class="alle" href={site.links.googleProfil} rel="noopener" target="_blank">
              Alle Bewertungen auf Google <Icon name="arrow-up-right" /><span class="visually-hidden">(öffnet in neuem Tab)</span>
            </a>
          )}
        </div>
      )
    }
  </div>
</section>

<style>
  .ergebnisse {
    background: var(--white);
  }

  .lead {
    margin-top: 1.25rem;
  }

  .methode {
    list-style: none;
    margin: 1.75rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    counter-reset: m;
  }

  .methode li {
    counter-increment: m;
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.5rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 1rem;
    color: var(--navy);
  }

  .methode li::before {
    content: counter(m);
    font-family: var(--serif);
    color: var(--gold-deep);
  }

  .fall {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding: clamp(1.75rem, 3vw, 2.25rem);
    background: var(--white);
    border: 1px solid var(--line);
    border-top: 3px solid var(--navy);
    border-radius: var(--radius);
  }

  .fall h3 {
    font-size: 1.5rem;
  }

  .label {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--stone);
    margin-bottom: 0.25rem;
  }

  .vorher p {
    color: var(--stone);
    font-size: 1.0625rem;
  }

  .loesung {
    font-size: 1.0625rem;
    color: var(--ink);
  }

  .nachher {
    margin-top: auto;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }

  .nachher .label {
    color: var(--gold-deep);
  }

  .wert {
    font-family: var(--serif);
    font-size: clamp(2.25rem, 1.8rem + 1.4vw, 3.25rem);
    font-weight: 500;
    line-height: 1.05;
    color: var(--navy);
    font-variant-numeric: lining-nums;
  }

  /* Zwei Zeilen reserviert, damit „Nachher“ in allen Karten auf einer Höhe steht. */
  .einheit {
    min-height: 3em;
    line-height: 1.5;
    margin-top: 0.4rem;
    font-size: 1rem;
    color: var(--stone);
  }

  .stimmen {
    margin-top: 4rem;
  }

  .stimmen ul {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr));
    gap: 2rem;
  }

  .sterne {
    display: flex;
    gap: 0.2rem;
    color: var(--gold-deep);
  }

  .sterne :global(svg) {
    width: 1.1rem;
    height: 1.1rem;
  }

  .stimmen blockquote {
    margin: 0.5rem 0;
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--navy);
  }

  .name {
    font-size: 1rem;
    color: var(--stone);
  }

  .alle {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1.5rem;
    font-weight: 600;
  }

  .alle :global(svg) {
    width: 1rem;
    height: 1rem;
  }

</style>
