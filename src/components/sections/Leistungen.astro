---
import Icon from '../Icon.astro';

// Neue Themen einfach als weiteres Objekt ergänzen. Nummer, Zähler und
// Karussell passen sich automatisch an.
const leistungen = [
  {
    name: 'Consulting',
    titel: 'KI-Einführung, die im Alltag funktioniert',
    kurz: 'Ich führe KI dort ein, wo sie Ihrem Team sofort Arbeit abnimmt, aufbauend auf dem, was Sie schon haben.',
    punkte: [
      ['KI-Einführung', 'DSGVO-konforme KI-Plattform, passend zu Ihrer bestehenden Infrastruktur. Eingerichtet, angebunden, im Einsatz.'],
      ['Bordmittelprüfung', 'Was steckt schon in Microsoft 365, ERP oder Telefonanlage und wird nicht genutzt? Oft liegt der schnellste Hebel bereits im Haus.'],
      ['Echte Business-Probleme lösen', 'Wiederkehrende Aufgaben automatisieren, Rechnungs- und Angebotsprozesse verschlanken, Wissen zugänglich machen.'],
      ['Systemprobleme beheben', 'Schnittstellen, Medienbrüche, doppelte Datenhaltung: Prozesse und Strukturen so ordnen, dass Technik wirken kann.'],
    ],
    beleg: '1,5 Vollzeitstellen in 2 Monaten eingespart.',
  },
  {
    name: 'Coaching',
    titel: 'Führung durch die Transformation',
    kurz: 'Transformation ist Führungsaufgabe. Ich begleite Geschäftsführung und Führungskräfte dabei, sie zu steuern, statt von ihr getrieben zu werden.',
    punkte: [
      ['Klarheit', 'Wo lohnt sich KI für uns, und wo nicht?'],
      ['Entscheiden', 'Prioritäten setzen und Entscheidungen treffen, ohne Dreijahresplan.'],
      ['Team mitnehmen', 'Ängste ernst nehmen, Veränderung verständlich kommunizieren.'],
      ['Neue Rollen', 'Verantwortlichkeiten im Umgang mit KI klar definieren.'],
    ],
    beleg: 'Zentralen Servicebereich mit fast 50 Mitarbeitenden aufgebaut: Veränderung unter Beteiligung der Mitarbeitenden mit umfassender technischer Transformation umgesetzt.',
  },
  {
    name: 'Training',
    titel: 'KI sicher im Arbeitsalltag nutzen',
    kurz: 'Ihre Mitarbeitenden lernen, mit KI und den neuen Prozessen souverän zu arbeiten. Praxisnah, an ihren eigenen Aufgaben.',
    punkte: [
      ['Grundlagen', 'Was KI kann, was nicht, und wie man gute Ergebnisse bekommt.'],
      ['Anwendung', 'Üben an echten Aufgaben aus dem eigenen Arbeitsalltag.'],
      ['Neue Prozesse', 'Einführung in die neuen, digitalisierten Abläufe.'],
      ['Datenschutz', 'Sichere Nutzung von KI im Unternehmen.'],
    ],
    beleg: 'Manager für angewandte KI-Transformation (IHK), Dozent und diverse umgesetzte Projekte mit großer IT-Komponente.',
  },
];
---
<section class="section leistungen" id="leistungen" aria-labelledby="leistungen-title">
  <div class="wrap kopf">
    <header class="intro">
      <h2 id="leistungen-title" data-reveal>Mein Fachwissen aus 20 Jahren Praxis, verbunden mit KI.</h2>
      <p class="lead muted" data-reveal style="--i: 1">
        Studien nennen drei Voraussetzungen, damit KI Wert schafft: Strategie, Training und Systeme. Genau dafür stehen
        meine drei Leistungen.
      </p>
    </header>

    <div class="steuerung" data-reveal style="--i: 2">
      <p class="zaehler" aria-hidden="true">
        <span data-aktuell>01</span> / {String(leistungen.length).padStart(2, '0')}
      </p>
      <button type="button" class="pfeil" data-zurueck aria-controls="leistungen-track" aria-label="Vorherige Leistung">
        <Icon name="arrow-left" />
      </button>
      <button type="button" class="pfeil" data-weiter aria-controls="leistungen-track" aria-label="Nächste Leistung">
        <Icon name="arrow-right" />
      </button>
    </div>
  </div>

  <ol class="track" id="leistungen-track" tabindex="0" aria-label="Leistungen, seitlich blättern" data-reveal style="--i: 2">
    {
      leistungen.map((l, i) => (
        <li class="karte" aria-label={`${i + 1} von ${leistungen.length}: ${l.name}`}>
          <p class="kennung">
            <span class="nr">{String(i + 1).padStart(2, '0')}</span>
            <span class="name">{l.name}</span>
          </p>
          <h3>{l.titel}</h3>
          <p class="kurz">{l.kurz}</p>
          <dl>
            {l.punkte.map(([t, d]) => (
              <div>
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))}
          </dl>
          <p class="beleg">
            <Icon name="check" />
            <span>
              <strong>Beleg:</strong> {l.beleg}
            </span>
          </p>
        </li>
      ))
    }
  </ol>

  <div class="wrap">
    <div class="fortschritt" aria-hidden="true"><span></span></div>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('#leistungen');
  const track = section?.querySelector<HTMLElement>('.track');
  if (section && track) {
    const karten = [...track.querySelectorAll<HTMLElement>('.karte')];
    const zurueck = section.querySelector<HTMLButtonElement>('[data-zurueck]')!;
    const weiter = section.querySelector<HTMLButtonElement>('[data-weiter]')!;
    const aktuell = section.querySelector<HTMLElement>('[data-aktuell]')!;
    const balken = section.querySelector<HTMLElement>('.fortschritt span')!;
    const ruhig = window.matchMedia('(prefers-reduced-motion: reduce)');

    const schritt = () => karten[0].offsetWidth + parseFloat(getComputedStyle(track).columnGap || '0');

    const update = () => {
      const max = track.scrollWidth - track.clientWidth;
      const pos = track.scrollLeft;
      const index = max <= 1 ? 0 : pos >= max - 2 ? karten.length - 1 : Math.round(pos / schritt());
      aktuell.textContent = String(index + 1).padStart(2, '0');
      zurueck.disabled = pos <= 2;
      weiter.disabled = pos >= max - 2;
      const sichtbar = max <= 0 ? 1 : track.clientWidth / track.scrollWidth;
      balken.style.width = `${sichtbar * 100}%`;
      balken.style.transform = `translateX(${max <= 0 ? 0 : (pos / max) * ((1 - sichtbar) / sichtbar) * 100}%)`;
    };

    const blaettern = (richtung: number) =>
      track.scrollBy({ left: richtung * schritt(), behavior: ruhig.matches ? 'auto' : 'smooth' });

    zurueck.addEventListener('click', () => blaettern(-1));
    weiter.addEventListener('click', () => blaettern(1));
    track.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') { e.preventDefault(); blaettern(1); }
      if (e.key === 'ArrowLeft') { e.preventDefault(); blaettern(-1); }
    });
    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    update();
  }
</script>

<style>
  .leistungen {
    background: var(--white);
    overflow: hidden;
  }

  .kopf {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem 3rem;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .intro {
    display: grid;
    gap: 1.25rem;
    max-width: 50rem;
  }

  /* Steuerung nur mit JavaScript; ohne JS bleibt die Leiste seitlich scrollbar. */
  .steuerung {
    display: none;
    align-items: center;
    gap: 0.75rem;
    flex: none;
  }

  :global(.js) .steuerung {
    display: flex;
  }

  .zaehler {
    margin-right: 0.75rem;
    font-family: var(--serif);
    font-size: 1.25rem;
    color: var(--stone);
    font-variant-numeric: lining-nums tabular-nums;
  }

  .zaehler span {
    color: var(--navy);
  }

  .pfeil {
    display: grid;
    place-items: center;
    width: 3.25rem;
    height: 3.25rem;
    border: 1px solid var(--navy);
    border-radius: 50%;
    background: transparent;
    color: var(--navy);
    cursor: pointer;
    transition:
      background-color 200ms var(--ease-out),
      color 200ms var(--ease-out),
      opacity 200ms var(--ease-out),
      transform 160ms var(--ease-out);
  }

  .pfeil :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }

  .pfeil:active:not(:disabled) {
    transform: scale(0.94);
  }

  .pfeil:disabled {
    opacity: 0.3;
    cursor: default;
  }

  .pfeil:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: 3px;
  }

  @media (hover: hover) and (pointer: fine) {
    .pfeil:hover:not(:disabled) {
      background: var(--navy);
      color: var(--white);
    }
  }

  /* Leiste läuft rechts bis an den Bildschirmrand, links bündig mit dem Raster. */
  .track {
    --rand: max(var(--gutter), calc((100% - var(--max)) / 2 + var(--gutter)));
    list-style: none;
    margin: 0;
    padding: 0.25rem var(--rand) 0.5rem;
    scroll-padding-inline: var(--rand);
    display: flex;
    gap: clamp(1rem, 2vw, 1.75rem);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    overscroll-behavior-x: contain;
  }

  .track:focus-visible {
    outline: 2px solid var(--gold-deep);
    outline-offset: -2px;
  }

  :global(.js) .track {
    scrollbar-width: none;
  }

  :global(.js) .track::-webkit-scrollbar {
    display: none;
  }

  .karte {
    flex: 0 0 min(36rem, 86%);
    scroll-snap-align: start;
    container-type: inline-size;
    display: flex;
    flex-direction: column;
    padding: clamp(1.75rem, 3.5vw, 3rem);
    background: var(--ivory);
    border-top: 3px solid var(--gold);
    border-radius: var(--radius);
  }

  .kennung {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .nr {
    font-family: var(--serif);
    font-size: 3rem;
    line-height: 1;
    color: var(--gold-deep);
    font-variant-numeric: lining-nums;
  }

  .name {
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    font-size: 0.875rem;
    color: var(--stone);
  }

  h3 {
    font-size: clamp(1.5rem, 1.25rem + 0.9vw, 2rem);
  }

  .kurz {
    margin-top: 1rem;
    color: var(--ink);
  }

  dl {
    margin: 2rem 0 0;
    padding-top: 1.75rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 1.25rem 2rem;
  }

  @container (min-width: 28rem) {
    dl {
      grid-template-columns: 1fr 1fr;
    }
  }

  dt {
    font-weight: 600;
    color: var(--navy);
    margin-bottom: 0.25rem;
  }

  dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.55;
    color: var(--stone);
  }

  .beleg {
    display: flex;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 2rem;
    font-size: 1rem;
    line-height: 1.5;
  }

  .beleg :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    flex: none;
    margin-top: 0.1rem;
    color: var(--gold-deep);
  }

  .beleg strong {
    color: var(--navy);
  }

  .fortschritt {
    display: none;
    height: 2px;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    background: var(--line);
    overflow: hidden;
  }

  :global(.js) .fortschritt {
    display: block;
  }

  .fortschritt span {
    display: block;
    height: 100%;
    width: 50%;
    background: var(--navy);
  }

  @media (max-width: 720px) {
    .kopf {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .track {
      scroll-behavior: smooth;
    }
  }
</style>
