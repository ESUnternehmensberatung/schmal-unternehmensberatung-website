---
import Icon from '../Icon.astro';
import { site } from '../../config/site';
---
<section class="whitepaper" id="whitepaper" aria-labelledby="whitepaper-title">
  <div class="wrap wp-grid">
    <div class="cover-buehne" data-reveal aria-hidden="true">
      <div class="seite seite-2"></div>
      <div class="seite seite-1"></div>
      <div class="cover">
        <p class="cover-label">Whitepaper</p>
        <p class="cover-titel">
          <span class="cover-zahl">5</span>
          Gründe, warum die meisten KI-Projekte bei Mittelständlern und Freiberuflern <em>scheitern</em>
        </p>
        <div class="cover-fuss">
          <span><strong>Schmal</strong> Unternehmensberatung</span>
          <span>{new Date().getFullYear()}</span>
        </div>
      </div>
    </div>

    <div class="wp-text">
      <p class="kontext" data-reveal>Noch nicht bereit für ein Gespräch?</p>
      <h2 id="whitepaper-title" data-reveal style="--i: 1">
        5 Gründe, warum die meisten KI-Projekte bei Mittelständlern und Freiberuflern scheitern
      </h2>
      <p class="beschreibung" data-reveal style="--i: 2">
        Die häufigsten Stolpersteine aus Studien und Praxis und wie Sie sie vermeiden. 21 Seiten mit Praxisinterview, Selbstcheck,
        90-Tage-Plan und Quellen. Kostenfrei als PDF per E-Mail.
      </p>
      <div class="wp-aktion" data-reveal style="--i: 3">
        <a class="btn btn-primary" href={site.links.whitepaper}>
          Whitepaper anfordern <Icon name="arrow-right" />
        </a>
        <p class="klein">Kostenfrei. Abmeldung jederzeit möglich.</p>
      </div>
    </div>
  </div>
</section>

<section class="section abschluss dark" id="kontakt" aria-labelledby="abschluss-title">
  <div class="wrap">
    <h2 id="abschluss-title" data-reveal>Zwei konkrete Hebel. In <em class="accent">45 Minuten.</em></h2>
    <p class="lead" data-reveal style="--i: 1">
      In der Quick-Win-Analyse schildern Sie Ihre Lage. Sie gehen mit zwei konkreten Hebeln raus, die Ihr Team sofort
      entlasten. Kostenfrei und unverbindlich.
    </p>
    <div class="actions" data-reveal style="--i: 2">
      <a class="btn btn-primary" href={site.links.quickWin}>
        Quick-Win-Analyse anfragen <Icon name="arrow-right" />
      </a>
      <a class="btn btn-ghost" href={site.links.angebot}>Angebot anfordern</a>
    </div>
    <ul class="direkt" data-reveal style="--i: 3">
      <li>
        <Icon name="envelope-simple" />
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </li>
      <li>
        <Icon name="phone" />
        <a href={site.phoneHref}>{site.phone}</a>
      </li>
    </ul>
  </div>
</section>

<style>
  .whitepaper {
    background: var(--ivory);
    padding-block: var(--section);
    border-top: 1px solid var(--line);
    overflow: hidden;
  }

  .wp-grid {
    display: grid;
    grid-template-columns: 5fr 7fr;
    gap: clamp(3rem, 7vw, 7rem);
    align-items: center;
  }

  /* PDF-Vorschau: Cover mit zwei angedeuteten Seiten dahinter */
  .cover-buehne {
    position: relative;
    width: min(100%, 22rem);
    justify-self: center;
    aspect-ratio: 1 / 1.414;
  }

  .seite,
  .cover {
    position: absolute;
    inset: 0;
    border-radius: var(--radius);
  }

  .seite {
    background: var(--white);
    border: 1px solid var(--line);
  }

  .seite-2 {
    transform: translate(1.4rem, 0.9rem) rotate(4deg);
  }

  .seite-1 {
    transform: translate(0.7rem, 0.45rem) rotate(2deg);
  }

  .cover {
    display: flex;
    flex-direction: column;
    padding: 12% 11% 9%;
    background: var(--navy);
    color: var(--white);
    box-shadow: var(--shadow), 0 30px 60px -30px rgb(15 36 56 / 0.45);
    transition: transform 400ms var(--ease-out);
  }

  .cover::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 6%;
    background: var(--navy-deep);
    border-radius: var(--radius) 0 0 var(--radius);
  }

  .cover-label {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    padding-bottom: 0.9rem;
    border-bottom: 1px solid var(--line-dark);
  }

  .cover-titel {
    margin-top: 1.5rem;
    font-family: var(--serif);
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.6rem);
    line-height: 1.22;
    color: var(--white);
  }

  .cover-zahl {
    display: block;
    font-size: 4.5em;
    line-height: 0.9;
    color: var(--gold);
    font-variant-numeric: lining-nums;
  }

  .cover-titel em {
    font-style: italic;
    color: var(--gold);
  }

  .cover-fuss {
    margin-top: auto;
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 0.9rem;
    border-top: 1px solid var(--line-dark);
    font-size: 0.75rem;
    color: var(--on-dark-muted);
  }

  .cover-fuss strong {
    color: var(--white);
    font-weight: 700;
  }

  @media (hover: hover) and (pointer: fine) {
    .cover-buehne:hover .cover {
      transform: translateY(-6px) rotate(-1deg);
    }
  }

  .kontext {
    font-weight: 600;
    color: var(--gold-deep);
    margin-bottom: 0.75rem;
  }

  .whitepaper h2 {
    font-size: var(--step-3);
    max-width: 18em;
  }

  .beschreibung {
    margin-top: 1.25rem;
    max-width: 34em;
    color: var(--stone);
  }

  .wp-aktion {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
    margin-top: 2rem;
  }

  .klein {
    font-size: 0.9375rem;
    color: var(--stone);
  }

  .abschluss h2 {
    font-size: clamp(2.5rem, 1.6rem + 3.4vw, 4.25rem);
    max-width: 16em;
  }

  .lead {
    margin-top: 1.5rem;
    color: var(--on-dark);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2.5rem;
  }

  .direkt {
    list-style: none;
    margin: 3rem 0 0;
    padding: 1.75rem 0 0;
    border-top: 1px solid var(--line-dark);
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2.5rem;
  }

  .direkt li {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
  }

  .direkt :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--gold);
  }

  .direkt a {
    color: var(--on-dark);
    text-decoration: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .direkt a:hover {
      color: var(--gold);
    }
  }

  @media (max-width: 860px) {
    .wp-grid {
      grid-template-columns: 1fr;
    }
    .cover-buehne {
      width: min(80%, 18rem);
      justify-self: start;
    }
  }

  @media (max-width: 480px) {
    .actions .btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
