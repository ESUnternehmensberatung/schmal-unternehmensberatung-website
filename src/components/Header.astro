---
import { Image } from 'astro:assets';
import logo from '../../assets/logo/logo-quer-transparent.png';
import { url } from '../utils/url';
import Icon from './Icon.astro';
import { site } from '../config/site';

// Desktop: die wichtigsten Seiten direkt sichtbar, alles Weitere im Menü (Burger).
const hauptlinks = [
  { href: url('/ki-schulung/'), label: 'KI-Schulung' },
  { href: url('/versicherungen/'), label: 'Versicherungsbranche' },
  { href: url('/blog/'), label: 'Blog' },
];
const gruppen = [
  {
    titel: 'Angebot',
    links: [
      { href: url('/#leistungen'), label: 'Leistungen' },
      { href: url('/ki-schulung/'), label: 'KI-Schulung' },
      { href: url('/versicherungen/'), label: 'Für die Versicherungsbranche' },
      { href: url('/#ablauf'), label: 'Ablauf' },
    ],
  },
  {
    titel: 'Mehr erfahren',
    links: [
      { href: url('/#ueber-mich'), label: 'Über mich' },
      { href: url('/#ergebnisse'), label: 'Ergebnisse' },
      { href: url('/#faq'), label: 'FAQ' },
      { href: url('/blog/'), label: 'Blog' },
    ],
  },
];
---
<header class="header dark">
  <div class="wrap bar">
    <a class="brand" href={url()} aria-label={`${site.name}, zur Startseite`}>
      <Image src={logo} alt="" widths={[200, 400]} sizes="200px" loading="eager" />
    </a>

    <nav class="nav" aria-label="Hauptnavigation">
      <ul>
        {hauptlinks.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
      </ul>
    </nav>

    <a class="btn btn-primary header-cta" href={site.links.quickWin}>Quick-Win-Analyse anfragen</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-menu">
      <span class="menu-label">Menü</span>
      <Icon name="list" class="i-open" />
      <Icon name="x" class="i-close" />
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" hidden>
    <nav class="wrap menu-grid" aria-label="Menü">
      {gruppen.map((g) => (
        <div class="gruppe">
          <p class="gruppe-titel">{g.titel}</p>
          <ul>
            {g.links.map((item) => <li><a href={item.href}>{item.label}</a></li>)}
          </ul>
        </div>
      ))}
      <div class="menu-cta">
        <p>Kostenfrei, 45 Minuten, zwei konkrete Hebel.</p>
        <a class="btn btn-primary" href={site.links.quickWin}>Quick-Win-Analyse anfragen</a>
      </div>
    </nav>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.menu-toggle');
  const menu = document.getElementById('mobile-menu');
  if (toggle && menu) {
    const setOpen = (open: boolean) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        menu.hidden = false;
        requestAnimationFrame(() => menu.classList.add('is-open'));
      } else {
        menu.classList.remove('is-open');
        menu.hidden = true;
      }
    };
    toggle.addEventListener('click', () => setOpen(toggle.getAttribute('aria-expanded') !== 'true'));
    menu.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a')) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  }
</script>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--line-dark);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 2rem;
    min-height: 4.5rem;
  }

  /* Logo: freigestellt aus assets/logo (scripts/logos.cjs) */
  .brand {
    display: block;
    margin-right: auto;
    line-height: 0;
  }

  .brand :global(img) {
    width: auto;
    height: 2.75rem;
  }

  .nav ul {
    display: flex;
    gap: 1.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav a {
    font-size: 1rem;
    text-decoration: none;
    color: var(--on-dark-muted);
  }

  @media (hover: hover) and (pointer: fine) {
    .nav a:hover {
      color: var(--white);
    }
  }

  .header-cta {
    min-height: 2.75rem;
    padding: 0.6rem 1.1rem;
    font-size: 0.975rem;
  }

  .menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 2.75rem;
    padding: 0 0.9rem;
    font: inherit;
    font-size: 0.975rem;
    border: 1px solid var(--line-dark);
    border-radius: var(--radius);
    background: transparent;
    color: var(--white);
    cursor: pointer;
    transition: transform 160ms var(--ease-out);
  }

  .menu-toggle:active {
    transform: scale(0.95);
  }

  .menu-toggle :global(svg) {
    width: 1.35rem;
    height: 1.35rem;
  }

  .menu-toggle :global(.i-close),
  .menu-toggle[aria-expanded='true'] :global(.i-open) {
    display: none;
  }

  .menu-toggle[aria-expanded='true'] :global(.i-close) {
    display: block;
  }

  .mobile-menu {
    max-height: calc(100dvh - 4.5rem);
    overflow-y: auto;
    border-top: 1px solid var(--line-dark);
    padding-block: 1rem 1.75rem;
    opacity: 0;
    transform: translateY(-6px);
    transition:
      opacity 200ms var(--ease-out),
      transform 200ms var(--ease-out);
  }

  .mobile-menu.is-open {
    opacity: 1;
    transform: none;
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr)) minmax(0, 0.9fr);
    gap: 1.5rem clamp(2rem, 4vw, 4rem);
    padding-top: 1rem;
  }

  .gruppe-titel {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.25rem;
  }

  .mobile-menu ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .mobile-menu li a {
    display: block;
    padding: 0.7rem 0;
    font-family: var(--serif);
    font-size: 1.4rem;
    text-decoration: none;
    color: var(--white);
    border-bottom: 1px solid var(--line-dark);
  }

  @media (hover: hover) and (pointer: fine) {
    .mobile-menu li a:hover {
      color: var(--gold);
    }
  }

  .menu-cta {
    align-self: end;
  }

  .menu-cta p {
    color: var(--on-dark-muted);
    margin-bottom: 1rem;
  }

  @media (max-width: 1119px) {
    .nav {
      display: none;
    }
    .bar {
      gap: 1rem;
    }
  }

  @media (max-width: 860px) {
    .menu-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 480px) {
    .menu-label {
      display: none;
    }
    .menu-toggle {
      padding: 0;
      width: 2.75rem;
      justify-content: center;
    }
  }

  @media (max-width: 640px) {
    .header-cta {
      display: none;
    }
    .brand :global(img) {
      height: 2.35rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transform: none;
    }
  }
</style>
