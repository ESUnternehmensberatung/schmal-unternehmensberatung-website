---
// Icons aus @phosphor-icons/core (regular), lokal in src/icons abgelegt.
interface Props {
  name: 'arrow-right' | 'arrow-up-right' | 'plus' | 'list' | 'x' | 'envelope-simple' | 'phone' | 'check' | 'star-fill';
  class?: string;
}
const { name, class: className } = Astro.props;
const icons = import.meta.glob<string>('../icons/*.svg', { query: '?raw', import: 'default', eager: true });
const svg = (icons[`../icons/${name}.svg`] ?? '').replace('<svg ', `<svg aria-hidden="true" focusable="false" class="icon ${className ?? ''}" `);
---
<Fragment set:html={svg} />
