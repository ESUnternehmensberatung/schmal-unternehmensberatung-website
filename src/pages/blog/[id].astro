---
import { getCollection, render } from 'astro:content';
import Text from '../../layouts/Text.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const artikel = await getCollection('blog', ({ data }) => !data.entwurf);
  return artikel.map((a) => ({ params: { id: a.id }, props: { a } }));
}

const { a } = Astro.props;
const { Content } = await render(a);
const datum = new Intl.DateTimeFormat('de-DE', { dateStyle: 'long' }).format(a.data.datum);
const fachartikel = a.data.kategorie === 'fachartikel';
const artikelUrl = `${site.url}/blog/${a.id}/`;
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${artikelUrl}#artikel`,
  headline: a.data.title,
  description: a.data.description,
  datePublished: a.data.datum.toISOString().slice(0, 10),
  inLanguage: 'de-DE',
  mainEntityOfPage: artikelUrl,
  author: { '@type': 'Person', '@id': `${site.url}/#inhaber`, name: site.owner, url: site.url },
  publisher: { '@type': 'ProfessionalService', '@id': `${site.url}/#unternehmen`, name: site.name },
  image: `${site.url}/og-image.png`,
};
---
<Text
  title={`${a.data.title} | ${site.name}`}
  description={a.data.description}
  heading={a.data.title}
  meta={fachartikel ? `Fachartikel von Eduard Schmal, ${datum}` : `${a.data.produkt}, ${datum}`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  {
    fachartikel ? (
      <p slot="vorspann" class="hinweis">
        Dieser Artikel ersetzt keine Rechts- oder Steuerberatung. Er gibt den Stand vom {datum} wieder.
      </p>
    ) : (
      <p slot="vorspann" class="hinweis">
        <strong>Transparenz:</strong> Ich erhalte bei Vermittlung von {a.data.produkt} eine Provision. Ihr Preis ändert
        sich dadurch nicht.
      </p>
    )
  }
  <Content />
  {
    fachartikel && (
      <aside class="cta">
        <p>
          <strong>Sie möchten wissen, wo in Ihrem Betrieb der größte Hebel liegt?</strong> In der kostenfreien
          Quick-Win-Analyse finden wir in 45 Minuten zwei konkrete Ansatzpunkte.
        </p>
        <a href={site.links.quickWin}>Quick-Win-Analyse anfragen</a>
      </aside>
    )
  }
</Text>

<style>
  .hinweis {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    font-size: 1rem;
    color: var(--stone);
  }
  .hinweis strong {
    color: var(--navy);
  }
  .cta {
    margin-top: 2.5rem;
    padding: 1.5rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    display: grid;
    gap: 1rem;
  }
  .cta a {
    justify-self: start;
    font-weight: 600;
    color: var(--navy);
  }
</style>
