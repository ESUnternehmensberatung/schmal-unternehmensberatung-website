---
import { url } from '../../utils/url';
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';

// Belegt im Angebotsformular die passende Option im Feld „Wofür wünschen Sie ein Angebot?“ vor
const anfrage = `${site.links.angebot}?quelle=ki-starttag&q10_checkbox8=${encodeURIComponent('KI-Starttag für bis zu 12 Personen')}`;
const anfrageGrow = `${site.links.angebot}?quelle=grow-schulung&q10_checkbox8=${encodeURIComponent('KI-Schulung G.R.O.W.')}`;

const formate = [
  ['Dauer', '4 Stunden vor Ort', '2 Stunden, remote oder vor Ort'],
  ['Inhalte', 'Alle Themen in der Tiefe, mit Übungen an echten Aufgaben aus Ihrem Betrieb', 'Die Themen kompakt nach G.R.O.W.: Grundlagen, Risiken, Orientierung, Wirkung'],
  ['Ihr Team geht raus mit', 'eigenen Anwendungsfällen, die ab Montag Zeit sparen', 'guten Beispielen, die sich direkt übertragen lassen'],
  ['Bordmittel-Check und Kurzbericht', 'inklusive, mit der Geschäftsführung', 'nicht enthalten'],
  ['Nachweis', 'Lernplattform, Abschlusstest und Nachweis KI-Kompetenz je Person', 'Teilnahmezertifikat je Person'],
  ['Anrechnung', '25 % des Festpreises, wenn Sie innerhalb von 3 Monaten eine Umsetzung beauftragen', '10 % auf einen KI-Starttag oder weitere Projekte'],
];

// IDD-Add-on: freigegeben am 24.11.2026 (false blendet den Abschnitt aus).
const zeigeIdd = true;
const anfrageIdd = `${site.links.angebot}?quelle=idd-add-on`;
// Belegt im Angebotsformular die IDD-Varianten vor (Feld „Wofür wünschen Sie ein Angebot?“)
const anfrageStarttagIdd = `${site.links.angebot}?quelle=idd-add-on&q10_checkbox8=${encodeURIComponent('KI-Starttag für bis zu 12 Personen mit IDD Stunden')}`;
const anfrageGrowIdd = `${site.links.angebot}?quelle=idd-add-on&q10_checkbox8=${encodeURIComponent('KI-Schulung G.R.O.W. mit IDD-Stunden')}`;

const iddInhalte = [
  ['KI in Beratung und Dokumentation', 'Bedarfsermittlung und Beratungsdokumentation nach §§ 61, 62 VVG mit KI vorbereiten, und was der Mensch vor dem Versand prüfen muss.'],
  ['Datenschutz in der Vermittlung', 'Gesundheitsdaten bei der Antragsaufnahme, Art. 9 DSGVO und welche Kundendaten in welches Werkzeug dürfen.'],
  ['Bedingungen und Angebote vergleichen', 'Bedingungswerke mit KI zusammenfassen und gegenüberstellen, ohne erfundene Leistungsinhalte zu übernehmen.'],
  ['Schadenfall und Vertragsverwaltung', 'Schadenmeldungen, Obliegenheiten und Kundenkorrespondenz mit KI vorbereiten, für Innendienst und Schadenbearbeitung.'],
  ['Agentur und Maklerbüro steuern', 'Vertriebseinheiten mit KI führen: Kennzahlen zur Kundenbetreuung, Bestandspflege, Qualitätsstandards und Wochenberichte für die Führungskraft.'],
  ['EU AI Act in der Versicherungsbranche', 'Hochrisiko bei Risikobewertung und Preisbildung in der Lebens- und Krankenversicherung und was das für den Vertrieb heißt.'],
  ['Kundenkommunikation und Werbung', 'KI-Texte im Vertrieb: Wettbewerbsrecht, unzulässige Werbung und der Umgang mit Interessenkonflikten.'],
];

const iddFormate = [
  {
    zahl: '3',
    titel: 'KI-Starttag + IDD',
    link: anfrageStarttagIdd,
    text: 'Die Schulung vor Ort, mit Übungen an Fällen aus Ihrem Vertrieb. Danach vertiefen Ihre Mitarbeitenden die Inhalte online und schließen mit einem kurzen Test ab.',
  },
  {
    zahl: '2',
    titel: 'G.R.O.W. + IDD',
    link: anfrageGrowIdd,
    text: 'Kompakt im interaktiven Webinar oder bei Ihnen vor Ort. Die Vertiefung mit kurzem Test folgt online, wann es in den Arbeitstag passt.',
  },
];

const iddProfil = [
  'Fachwirt für Versicherungen und Finanzen (IHK)',
  '17 Jahre Führungskraft und Manager in der Versicherungsbranche',
  'Internes Weiterbildungsprogramm eines Versicherers eingeführt, mehrfach durch BaFin-Prüfungen und interne Revision bestätigt',
  'MBA mit Schwerpunkt Digital Innovation',
  'Manager für angewandte KI-Transformation (IHK)',
  'Erlaubnisse nach §§ 34d und 34i GewO',
];

const iddSchritte = [
  ['Einladung', 'in Textform, mit Inhalten, erwerbbaren Kompetenzen und Zeitstunden'],
  ['Teilnahme', 'vor Ort oder im Webinar, Anwesenheit wird dokumentiert'],
  ['Vertiefung', 'online mit Abschlusstest als Lernerfolgskontrolle'],
  ['Nachweis', 'je Person mit allen Pflichtangaben, bereit für Ihre Unterlagen'],
];

// Fragen und Antworten: auf der Seite sichtbar und als FAQPage für Google und KI-Suche.
const fragen = [
  ['Für wen ist der KI-Starttag?', 'Für mittelständische Unternehmen, Kanzleien, Steuerberatungen, Praxen und Versicherungsbetriebe mit etwa 5 bis 50 Mitarbeitenden, die KI sicher einführen wollen, statt sie im Verborgenen nutzen zu lassen.'],
  ['Was ist die G.R.O.W.-Schulung?', 'Die kompakte Variante in 2 Stunden, remote oder vor Ort: Grundlagen, Risiken, Orientierung und Wirkung von KI, mit guten Beispielen aus dem Büroalltag. Ohne Bordmittel-Check und ohne Abschlusstest, dafür mit Teilnahmezertifikat je Person. 10 % des Preises rechne ich auf einen KI-Starttag oder weitere Projekte an.'],
  ['Ist der Nachweis ein offizielles Zertifikat?', 'Eine offizielle Zertifizierung für Art. 4 EU AI Act gibt es nicht. Verlangt wird, dass Sie Maßnahmen zur KI-Kompetenz ergreifen. Der Nachweis dokumentiert Schulung und bestandenen Abschlusstest je Person, damit Sie das bei Rückfragen belegen können.'],
  ['Zählt die KI-Schulung als IDD-Weiterbildung?', 'Mit dem IDD-Add-on ja: Die Module mit Versicherungsbezug werden als Weiterbildungszeit ausgewiesen, beim KI-Starttag bis zu 3 und bei der G.R.O.W.-Schulung bis zu 2 Zeitstunden. Jede Person erhält einen Weiterbildungsnachweis mit Datum, Umfang, Inhalt, Bezeichnung und Anbieter.'],
  ['Wer muss sich nach IDD weiterbilden?', 'Versicherungsvermittler und Versicherungsberater mit Erlaubnis nach § 34d GewO, ihre Beschäftigten, die bei Vermittlung oder Beratung mitwirken, und Mitarbeitende von Versicherungsunternehmen, die am Vertrieb beteiligt sind, auch in Vertragsverwaltung und Schadenbearbeitung. Die Pflicht beträgt 15 Zeitstunden pro Kalenderjahr (§ 34d Abs. 9 GewO, § 48 Abs. 2 VAG).'],
  ['Was passiert nach dem Starttag?', 'Sie entscheiden. Viele setzen die Hebel aus dem Kurzbericht mit mir um. Beauftragen Sie innerhalb von 3 Monaten, rechne ich 25 % des Festpreises an.'],
  ['Gibt es Fördermittel?', 'Je nach Bundesland und Programm lassen sich Schulungen und Beratung fördern. Die Prüfung von Fördermitteln gehört bei mir zu jeder Beratung dazu.'],
];

const seitenUrl = `${site.url}/ki-schulung/`;
const kurs = (id: string, name: string, description: string, modus: string[], stunden: string) => ({
  '@type': 'Course',
  '@id': `${seitenUrl}#${id}`,
  name,
  description,
  url: seitenUrl,
  inLanguage: 'de-DE',
  provider: { '@id': `${site.url}/#unternehmen` },
  instructor: { '@id': `${site.url}/#inhaber` },
  about: ['Künstliche Intelligenz', 'KI-Kompetenz nach Art. 4 EU AI Act', 'Datenschutz', 'Prompting', 'KI-Agenten'],
  audience: { '@type': 'BusinessAudience', audienceType: 'Mittelstand, Kanzleien, Praxen, Versicherungsvermittler' },
  hasCourseInstance: { '@type': 'CourseInstance', courseMode: modus, courseWorkload: stunden },
  offers: { '@type': 'Offer', url: seitenUrl, category: 'Festpreis auf Anfrage' },
});
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    kurs('ki-starttag', 'KI-Starttag', 'KI-Schulung vor Ort mit Übungen an echten Aufgaben, Bordmittel-Check und Kurzbericht für die Geschäftsführung, Lernplattform mit Abschlusstest und Nachweis der KI-Kompetenz nach Art. 4 EU AI Act je Person.', ['Onsite'], 'PT4H'),
    kurs('grow-schulung', 'G.R.O.W.-Schulung', 'Kompakte KI-Schulung nach G.R.O.W. (Grundlagen, Risiken, Orientierung, Wirkung), remote als interaktives Webinar oder vor Ort, mit Teilnahmezertifikat je Person.', ['Online', 'Onsite'], 'PT2H'),
    {
      '@type': 'Service',
      '@id': `${seitenUrl}#idd-add-on`,
      name: 'IDD-Add-on: KI-Schulung mit Weiterbildungsstunden für Versicherungsvermittler',
      serviceType: 'IDD-Weiterbildung nach § 34d Abs. 9 GewO und § 48 Abs. 2 VAG',
      description: 'Versicherungsbezogene Module zu KI in Beratung und Dokumentation, Datenschutz, Bedingungsvergleich, Schadenfall, Agentursteuerung, EU AI Act und Kundenkommunikation. Bis zu 3 Zeitstunden beim KI-Starttag, bis zu 2 Zeitstunden bei der G.R.O.W.-Schulung, mit Weiterbildungsnachweis je Person nach Anlage 3 VersVermV.',
      provider: { '@id': `${site.url}/#unternehmen` },
      audience: { '@type': 'BusinessAudience', audienceType: 'Versicherungsvermittler, Versicherungsmakler, Versicherungsunternehmen' },
      areaServed: { '@type': 'Country', name: 'Deutschland' },
      url: `${seitenUrl}#idd`,
    },
    {
      '@type': 'FAQPage',
      '@id': `${seitenUrl}#faq`,
      mainEntity: fragen.map(([f, antwort]) => ({ '@type': 'Question', name: f, acceptedAnswer: { '@type': 'Answer', text: antwort } })),
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Startseite', item: `${site.url}/` },
        { '@type': 'ListItem', position: 2, name: 'KI-Schulung', item: seitenUrl },
      ],
    },
  ],
};

const ablauf = [
  {
    titel: 'Vorbereitung',
    text: 'Sie füllen einen kurzen Fragebogen zu Team, Systemen und Aufgaben aus. Daraus baue ich Beispiele aus Ihrem Arbeitsalltag.',
  },
  {
    titel: '3 Stunden Schulung vor Ort',
    text: 'Grundlagen, sichere Nutzung und Üben an echten Aufgaben aus Ihrem Betrieb. Praxisnah, ohne Folienschlacht.',
  },
  {
    titel: '1 Stunde Bordmittel-Check',
    text: 'Mit der Geschäftsführung: Was steckt schon in Microsoft 365, ERP oder Telefonanlage und wird noch nicht genutzt?',
  },
  {
    titel: 'Test und Nachweis',
    text: 'Auf meiner Lernplattform vertiefen Ihre Mitarbeitenden die Inhalte und legen einen kurzen Abschlusstest ab. Danach erhält jede Person einen Nachweis.',
  },
  {
    titel: 'Kurzbericht',
    text: 'Sie erhalten die 3 bis 5 größten Hebel für Ihr Unternehmen, priorisiert und mit einer Einschätzung zu Aufwand und Nutzen.',
  },
];

const inhalte = [
  ['Woher KI kommt', 'Über 70 Jahre Geschichte in Kürze, warum es gerade jetzt so schnell geht und wofür GPT steht.'],
  ['Chancen und Risiken', 'Was KI in Medizin, Energie und Klima schon leistet, belegt mit Studien, und wo echte Gefahren wie Deepfake-Betrug lauern.'],
  ['Wie KI arbeitet', 'Sprachmodell, Token und Kontextfenster verständlich erklärt, mit Stärken, Grenzen und erfundenen Antworten.'],
  ['Gute Arbeitsaufträge', 'Eine einfache Formel für verlässliche Ergebnisse, geübt an echten Aufgaben aus Ihrem Betrieb.'],
  ['Vom Chat zum Agenten', 'Masterprompt, eigene Agenten, Skills und geplante Aufgaben: wie KI sich Ihre Vorgaben merkt und Arbeit selbst erledigt.'],
  ['Sicher arbeiten', 'Welche Daten in welches Werkzeug dürfen, kostenlos oder Business-Version, Prüfroutine und Regeln für Ihr Unternehmen.'],
];

const leistungen = [
  '4 Stunden vor Ort für bis zu 12 Teilnehmende',
  'Vorbereitung mit Beispielen aus Ihrem Betrieb',
  'Schulungsunterlagen und Vorlagen für den Alltag',
  'Zugang zur Lernplattform mit Abschlusstest',
  'Nachweis KI-Kompetenz gemäß Art. 4 EU AI Act je Teilnehmer',
  'Bordmittel-Check und Kurzbericht mit den größten Hebeln',
];
---
<Base
  title={`KI-Schulung mit Nachweis nach EU AI Act, auch mit IDD-Stunden | ${site.name}`}
  image={url('/og/ki-schulung.png')}
  description="KI-Schulung mit Nachweis nach Art. 4 EU AI Act: KI-Starttag vor Ort oder G.R.O.W. kompakt, remote oder vor Ort. Auch mit IDD-Weiterbildungsstunden."
  keywords={['KI-Schulung', 'KI-Schulung für Mitarbeitende', 'KI-Kompetenz Art. 4 EU AI Act', 'KI-Schulung Nachweis', 'KI-Starttag', 'G.R.O.W.-Schulung', 'KI-Webinar', 'IDD-Weiterbildung', 'IDD-Weiterbildungsstunden', 'Weiterbildung Versicherungsvermittler', '§ 34d GewO Weiterbildung', 'KI im Versicherungsvertrieb', 'Mittelstand', 'Kanzleien', 'Arztpraxen', 'Versicherungsmakler']}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <!-- Black-Friday-Aktion: sichtbar nur vom 27.11. bis 06.12.2026 (Datumsprüfung im Browser). Danach entfernen. -->
  <aside class="aktion-bf" id="black-friday" hidden aria-label="Black-Friday-Aktion">
    <div class="wrap aktion-bf-inner">
      <p><strong>Black Friday: 20&nbsp;% auf alle Schulungsformate</strong>, auch mit IDD-Stunden. Gilt für Buchungen bis 06.12.2026, der Schulungstermin kann auch 2027 liegen.</p>
      <a class="btn btn-primary" href={`${site.links.angebot}?quelle=black-friday`}>Angebot anfordern <Icon name="arrow-right" /></a>
    </div>
  </aside>
  <script is:inline>
    (function () {
      var jetzt = new Date();
      var start = new Date('2026-11-27T00:00:00+01:00');
      var ende = new Date('2026-12-07T00:00:00+01:00');
      if (jetzt >= start && jetzt < ende) {
        var el = document.getElementById('black-friday');
        if (el) el.hidden = false;
      }
    })();
  </script>
  <section class="kopf dark" aria-labelledby="schulung-title">
    <div class="wrap kopf-grid">
      <div>
        <p class="eyebrow">KI-Schulung</p>
        <h1 id="schulung-title">Vom Pflichtthema zum <em class="accent">Plan.</em></h1>
        <p class="lead">
          Unternehmen, die KI einsetzen, müssen Maßnahmen ergreifen, um die KI-Kompetenz ihrer Mitarbeitenden zu fördern
          (Art. 4 EU AI Act). Beide Schulungen sind eine solche Maßnahme, dokumentiert je Person. Sie wählen, wie tief es gehen soll.
        </p>
        <p class="lead lead-zusatz">Beide Schulungen sind auch mit IDD-Weiterbildungsstunden erhältlich.</p>
        <div class="aktion">
          <a class="btn btn-ghost" href="#formate">Formate vergleichen</a>
          <a class="btn btn-ghost" href="#idd">IDD-Schulungen</a>
        </div>
      </div>

      <div class="angebote">
        <article class="angebot haupt" aria-labelledby="karte-starttag">
          <p class="angebot-label">Gründlich</p>
          <h2 id="karte-starttag">KI-Starttag</h2>
          <p class="angebot-dauer">4&nbsp;Stunden vor Ort</p>
          <ul>
            <li>Jede Person geht mit eigenen Anwendungsfällen raus</li>
            <li>Bordmittel-Check und Kurzbericht für die Geschäftsführung</li>
            <li>Abschlusstest und Nachweis KI-Kompetenz je Person</li>
            <li><strong>25 % angerechnet</strong> bei Umsetzung innerhalb von 3 Monaten</li>
          </ul>
          <a class="btn btn-primary" href={anfrage}>Angebot anfordern <Icon name="arrow-right" /></a>
        </article>
        <article class="angebot" aria-labelledby="karte-grow">
          <p class="angebot-label">Kompakt</p>
          <h2 id="karte-grow">G.R.O.W.-Schulung</h2>
          <p class="angebot-dauer">2&nbsp;Stunden, remote oder vor Ort</p>
          <ul>
            <li>Grundlagen, Risiken, Orientierung, Wirkung</li>
            <li>Jede Person geht mit guten Beispielen raus</li>
            <li>Teilnahmezertifikat je Person</li>
            <li><strong>10 % angerechnet</strong> auf einen KI-Starttag oder weitere Projekte</li>
          </ul>
          <a class="btn btn-ghost" href={anfrageGrow}>Angebot anfordern <Icon name="arrow-right" /></a>
        </article>
      </div>
    </div>
  </section>

  <section class="section weiss" id="formate" aria-labelledby="formate-title">
    <div class="wrap">
      <h2 id="formate-title">Zwei Formate, ein Ziel</h2>
      <p class="formate-lead">Der KI-Starttag ist der gründliche Einstieg mit Analyse. Die G.R.O.W.-Schulung ist die kompakte Variante, wenn Ihr Team schnell einen sicheren Überblick braucht.</p>
      <div class="vergleich" role="table" aria-label="Vergleich KI-Starttag und G.R.O.W.-Schulung">
        <div class="v-kopf" role="row">
          <span role="columnheader"></span>
          <span role="columnheader" class="v-start">KI-Starttag</span>
          <span role="columnheader" class="v-grow">G.R.O.W.-Schulung</span>
        </div>
        {
          formate.map(([k, a, b]) => (
            <div class="v-zeile" role="row">
              <span role="rowheader" class="v-k">{k}</span>
              <span role="cell" class="v-a"><span class="v-mobil">KI-Starttag: </span>{a}</span>
              <span role="cell" class="v-b"><span class="v-mobil">G.R.O.W.: </span>{b}</span>
            </div>
          ))
        }
        <div class="v-zeile v-aktion" role="row">
          <span role="rowheader"></span>
          <span role="cell"><a class="btn btn-primary" href={anfrage}>Angebot KI-Starttag <Icon name="arrow-right" /></a></span>
          <span role="cell"><a class="btn btn-navy" href={anfrageGrow}>Angebot G.R.O.W.-Schulung <Icon name="arrow-right" /></a></span>
        </div>
      </div>
    </div>
  </section>

  {
    zeigeIdd && (
      <section class="section idd dark" id="idd" aria-labelledby="idd-title">
        <div class="wrap">
          <div class="idd-kopf">
            <p class="eyebrow">Für die Versicherungsbranche</p>
            <h2 id="idd-title">IDD-Add-on: KI-Schulung mit Weiterbildungsstunden</h2>
            <p class="idd-lead">
              Für Versicherungsvermittler, Versicherungsberater und Beschäftigte von Versicherungsunternehmen, die am Vertrieb
              mitwirken. Beide Schulungen gibt es mit Modulen aus dem Versicherungsalltag. Die Zeit zählt für Ihre
              Weiterbildungspflicht von 15 Stunden im Jahr nach § 34d Abs. 9 GewO bzw. § 48 Abs. 2 VAG.
            </p>
          </div>

          <div class="idd-formate">
            {iddFormate.map((f, i) => (
              <article class={i === 0 ? 'idd-format haupt' : 'idd-format'}>
                <p class="idd-zahl">
                  <span class="idd-bis">bis zu</span>
                  <span class="idd-ziffer">{f.zahl}</span>
                  <span class="idd-einheit">Zeitstunden</span>
                </p>
                <h3>{f.titel}</h3>
                <p>{f.text}</p>
                <a class="idd-format-link" href={f.link}>Angebot anfordern <Icon name="arrow-right" /></a>
              </article>
            ))}
          </div>

          <h3 class="idd-zwischen">Module mit Versicherungsbezug</h3>
          <ol class="idd-module">
            {iddInhalte.map(([t, d], i) => (
              <li>
                <span class="idd-nr" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
                <h4>{t}</h4>
                <p>{d}</p>
              </li>
            ))}
            <li class="idd-modul-eigen">
              <span class="idd-nr" aria-hidden="true">+</span>
              <h4>Ihr Thema fehlt?</h4>
              <p>Die Module passe ich an Ihren Vertrieb an: Makler, Ausschließlichkeit oder Innendienst eines Versicherers.</p>
            </li>
          </ol>

          <div class="idd-unten">
            <div class="idd-profil">
              <p class="eyebrow">Durchführung</p>
              <h3>Eduard Schmal</h3>
              <ul>
                {iddProfil.map((p) => (
                  <li>
                    <Icon name="check" />
                    {p}
                  </li>
                ))}
              </ul>
            </div>
            <div>
              <p class="eyebrow">So erhalten Sie Ihre Stunden</p>
              <ol class="idd-schritte">
                {iddSchritte.map(([t, d], i) => (
                  <li>
                    <span class="idd-schritt-nr" aria-hidden="true">{i + 1}</span>
                    <div>
                      <strong>{t}</strong>
                      <span>{d}</span>
                    </div>
                  </li>
                ))}
              </ol>
              <a class="btn btn-primary" href={anfrageIdd}>Angebot mit IDD-Add-on anfordern <Icon name="arrow-right" /></a>
            </div>
          </div>
        </div>
      </section>
    )
  }

  <section class="section" aria-labelledby="ablauf-title">
    <div class="wrap">
      <h2 id="ablauf-title">So läuft der KI-Starttag ab</h2>
      <ol class="schritte">
        {
          ablauf.map((s, i) => (
            <li>
              <span class="nr" aria-hidden="true">{i + 1}</span>
              <h3>{s.titel}</h3>
              <p>{s.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section weiss" aria-labelledby="inhalte-title">
    <div class="wrap zwei">
      <div>
        <h2 id="inhalte-title">Was Ihr Team lernt</h2>
        <dl class="inhalte">
          {
            inhalte.map(([t, d]) => (
              <div>
                <dt>{t}</dt>
                <dd>{d}</dd>
              </div>
            ))
          }
        </dl>
      </div>
      <div>
        <h2>Was Sie bekommen</h2>
        <ul class="haken">
          {
            leistungen.map((l) => (
              <li>
                <Icon name="check" />
                {l}
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="fragen-title">
    <div class="wrap fragen">
      <h2 id="fragen-title">Gut zu wissen</h2>
      <div class="fragen-grid">
        {
          fragen.map(([f, antwort]) => (
            <div>
              <h3>{f}</h3>
              <p>{antwort}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="schluss dark" aria-labelledby="schluss-title">
    <div class="wrap schluss-inner">
      <h2 id="schluss-title">Termin für Ihre KI-Schulung anfragen</h2>
      <p>Sie erhalten innerhalb von zwei Werktagen Ihr Festpreisangebot mit Terminvorschlägen.</p>
      <div class="aktion">
        <a class="btn btn-primary" href={anfrage}>Angebot KI-Starttag <Icon name="arrow-right" /></a>
        <a class="btn btn-ghost" href={anfrageGrow}>Angebot G.R.O.W.-Schulung</a>
      </div>
    </div>
  </section>
