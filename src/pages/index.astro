---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import Hero from '../components/sections/Hero.astro';
import Lage from '../components/sections/Lage.astro';
import Leistungen from '../components/sections/Leistungen.astro';
import Ablauf from '../components/sections/Ablauf.astro';
import UeberMich from '../components/sections/UeberMich.astro';
import Ergebnisse from '../components/sections/Ergebnisse.astro';
import StarttagHinweis from '../components/sections/StarttagHinweis.astro';
import Faq from '../components/sections/Faq.astro';
import Abschluss from '../components/sections/Abschluss.astro';
import { site } from '../config/site';

// Zielgruppen und Themen für Suchmaschinen und KI-Suche (SEO, GEO, AEO).
const zielgruppen = [
  'Mittelstand',
  'familiengeführte KMU',
  'Familienunternehmen',
  'Freiberufler',
  'Kanzleien',
  'Steuerberater',
  'Steuerkanzleien',
  'Rechtsanwaltskanzleien',
  'Arztpraxen',
  'Ärzte',
  'Zahnarztpraxen',
  'Versicherungsvermittler',
  'Versicherungsmakler',
  'Versicherungsunternehmen',
];
const themen = [
  'Digitale Transformation',
  'KI-Einführung',
  'Künstliche Intelligenz im Mittelstand',
  'KI-Beratung',
  'KI-Training',
  'KI-Schulung für Mitarbeitende',
  'KI-Kompetenz nach EU AI Act',
  'KI-Schulung mit Nachweis',
  'IDD-Weiterbildung für Versicherungsvermittler',
  'KI im Versicherungsvertrieb',
  'Restrukturierung und Krisenfrüherkennung',
  'Prozessoptimierung',
  'Prozessautomatisierung',
  'Workflow-Automatisierung',
  'KI-Agenten',
  'Bordmittelprüfung',
  'Microsoft 365',
  'ERP-Optimierung',
  'Digitaler Rechnungsworkflow',
  'Rechnungswesen digitalisieren',
  'Angebotsprozess beschleunigen',
  'Beschwerdemanagement',
  'Change Management',
  'Führungskräfte-Coaching',
  'Interim Management',
  'DSGVO-konforme KI',
  'Human in the Loop',
  'Fördermittel für Digitalisierung',
  'Quick-Win-Analyse',
];

const faq = (await getCollection('faq')).sort((a, b) => a.data.reihenfolge - b.data.reihenfolge);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${site.url}/#unternehmen`,
      name: site.name,
      slogan: 'Digitale Transformation für Mittelstand und freie Berufe',
      description:
        'Ich bin Unternehmensberater aus Eyendorf bei Lüneburg und führe KI im Mittelstand, in Kanzleien, Steuerberatungen und Arztpraxen ein: vor Ort in Niedersachsen, remote in ganz Deutschland. Consulting, Coaching und Training mit Fokus auf vorhandenen Systemen (Bordmitteln) und schnellen, messbaren Ergebnissen.',
      url: site.url,
      logo: `${site.url}/og-image.png`,
      image: `${site.url}/og-image.png`,
      email: site.email,
      telephone: site.phoneHref.replace('tel:', ''),
      address: {
        '@type': 'PostalAddress',
        streetAddress: 'Im Kamp 7',
        postalCode: '21376',
        addressLocality: 'Eyendorf',
        addressRegion: 'Niedersachsen',
        addressCountry: 'DE',
      },
      areaServed: [
        { '@type': 'Country', name: 'Deutschland' },
        { '@type': 'State', name: 'Niedersachsen' },
        { '@type': 'City', name: 'Lüneburg' },
      ],
      founder: { '@id': `${site.url}/#inhaber` },
      knowsAbout: themen,
      audience: zielgruppen.map((z) => ({ '@type': 'BusinessAudience', audienceType: z })),
      sameAs: [site.links.linkedin, site.links.provenExpert, site.links.googleProfil],
      hasOfferCatalog: {
        '@type': 'OfferCatalog',
        name: 'Leistungen',
        itemListElement: [
          ['Quick-Win-Analyse', 'Kostenfreies 45-minütiges Gespräch zu den größten Schmerzpunkten.'],
          ['KI-Einführung und Consulting', 'DSGVO-konforme KI-Einführung, Bordmittelprüfung, Prozessautomatisierung.'],
          ['Coaching für Führungskräfte', 'Begleitung von Geschäftsführung und Führungskräften durch die Transformation.'],
          ['KI-Starttag', 'KI-Schulung vor Ort mit Bordmittel-Check, Kurzbericht und Nachweis der KI-Kompetenz nach Art. 4 EU AI Act je Person.'],
          ['G.R.O.W.-Schulung', 'Kompakte KI-Schulung in 2 Stunden, remote oder vor Ort, mit Teilnahmezertifikat.'],
          ['IDD-Add-on', 'KI-Schulung mit Weiterbildungsstunden für Versicherungsvermittler nach § 34d Abs. 9 GewO und Anlage 3 VersVermV.'],
        ].map(([name, description]) => ({
          '@type': 'Offer',
          itemOffered: { '@type': 'Service', name, description },
        })),
      },
    },
    {
      '@type': 'Person',
      '@id': `${site.url}/#inhaber`,
      name: site.owner,
      jobTitle: 'Unternehmensberater für digitale Transformation und KI',
      hasCredential: [
        'Fachwirt für Versicherungen und Finanzen (IHK)',
        'MBA mit Schwerpunkt Digital Innovation',
        'Manager für angewandte KI-Transformation (IHK)',
        'Versicherungsmakler mit Erlaubnis nach § 34d GewO',
        'Immobiliardarlehensvermittler mit Erlaubnis nach § 34i GewO',
      ].map((name) => ({ '@type': 'EducationalOccupationalCredential', name })),
      worksFor: { '@id': `${site.url}/#unternehmen` },
      sameAs: [site.links.linkedin],
      knowsAbout: themen,
    },
    {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.data.frage,
        acceptedAnswer: { '@type': 'Answer', text: f.body?.trim() ?? '' },
      })),
    },
  ],
};
---
<Base
  title={`Digitale Transformation für Mittelstand und freie Berufe | ${site.name}`}
  description="Unternehmensberater aus Eyendorf bei Lüneburg: KI-Einführung für Mittelstand, Kanzleien, Steuerberatungen und Arztpraxen. Vor Ort in Niedersachsen, remote bundesweit."
  keywords={[...themen, ...zielgruppen, 'Unternehmensberatung', 'Eyendorf', 'Lüneburg', 'Unternehmensberater Lüneburg', 'Niedersachsen']}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <Hero />
  <Lage />
  <Leistungen />
  <StarttagHinweis />
  <Ablauf />
  <UeberMich />
  <Ergebnisse />
  <Faq />
  <Abschluss />
</Base>
