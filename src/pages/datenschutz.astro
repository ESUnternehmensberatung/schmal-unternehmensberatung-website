---
import { site } from '../config/site';
import { getEntry, render } from 'astro:content';
import Text from '../layouts/Text.astro';

const eintrag = await getEntry('rechtliches', 'datenschutz');
if (!eintrag) throw new Error('Datenschutzerklärung fehlt');
const { Content } = await render(eintrag);
---
<Text title={`Datenschutz | ${site.name}`} description={eintrag.data.description} heading={eintrag.data.title}>
  <Content />
</Text>
