---
import Base from './Base.astro';

interface Props {
  title: string;
  description: string;
  heading: string;
  meta?: string;
  keywords?: string[];
}
const { title, description, heading, meta, keywords } = Astro.props;
---
<Base title={title} description={description} keywords={keywords}>
  <slot name="head" slot="head" />
  <article class="section">
    <div class="wrap">
      <header class="kopf">
        <h1>{heading}</h1>
        {meta && <p class="meta">{meta}</p>}
        <slot name="vorspann" />
      </header>
      <div class="prose">
        <slot />
      </div>
    </div>
  </article>
</Base>

<style>
  .kopf {
    max-width: 44rem;
    margin-bottom: 3rem;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--line);
  }
  h1 {
    font-size: var(--step-3);
  }
  .meta {
    margin-top: 1rem;
    font-size: 1rem;
    color: var(--stone);
  }
</style>

<style is:global>
  .prose table {
    display: block;
    max-width: 100%;
    overflow-x: auto;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.95rem;
  }
  .prose th,
  .prose td {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    text-align: left;
    vertical-align: top;
  }
  .prose th {
    color: var(--navy);
    font-weight: 600;
  }
  .prose blockquote {
    margin: 1.5rem 0;
    padding: 1rem 1.25rem;
    border-left: 3px solid var(--gold, #c9a87c);
    background: var(--white);
  }
</style>
